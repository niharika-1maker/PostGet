# ==============================================================================
# AI CONTENT OS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values for your local environment.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Database, Auth, Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# AI LLM PROVIDERS (BYOK - Bring Your Own Key)
# ------------------------------------------------------------------------------
# Google Gemini (Default Free-Tier Provider via Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Alternative LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# VIDEO GENERATION PROVIDERS
# ------------------------------------------------------------------------------
# Set to 'mock' for $0-cost development without cloud API calls
VIDEO_PROVIDER=mock
REPLICATE_API_TOKEN=
LUMA_API_KEY=
KLING_API_KEY=

# ------------------------------------------------------------------------------
# VOICE / TTS PROVIDERS
# ------------------------------------------------------------------------------
# Set to 'edge-tts' for 100% free Microsoft Neural TTS (no key required)
TTS_PROVIDER=edge-tts
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# MEDIA & FFMPEG
# ------------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TEMP_MEDIA_DIR=./temp

# ------------------------------------------------------------------------------
# SOCIAL PUBLISHING OAUTH CREDENTIALS (Phase 7)
# ------------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
